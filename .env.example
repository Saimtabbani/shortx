# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit real secrets.

# Required: HS256 signing key for JWTs. Must be a long, random, high-entropy
# string (32+ bytes). Generate one with: openssl rand -base64 48
JWT_SECRET=

# Optional overrides
SHORTX_BASE_URL=http://localhost:8080
GRAFANA_ADMIN_PASSWORD=admin
